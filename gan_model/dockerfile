# Use the base TensorFlow training image
ARG IMAGE_REPO=<add the image repo name>

FROM $IMAGE_REPO/base-images/ubi9/python-3.11:latest

# Set working directory
WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt .

RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir -r requirements.txt

# Copy trainer module
COPY trainer trainer/

# Create output directory
RUN mkdir -p /app/output

# Set entrypoint to run the training script with argument parsing support
ENTRYPOINT ["python3", "-m", "trainer.train"]

